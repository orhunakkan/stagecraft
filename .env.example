PORT=3001
SESSION_SECRET=change-me-in-production
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional. Only needed for the audit-log-search lab's real persistence — see docs/azure-sql.md.
# Leave unset to use the lab's in-memory fallback store.
AZURE_SQL_CONNECTION_STRING=
# Optional. Set to "true" to allow the audit-log-search lab's reseed action when NODE_ENV=production.
# Needed on the deployed practice site so signed-in admins and E2E automation can reseed fixture data;
# leave unset for a real production deployment.
AUDIT_LOG_ALLOW_RESEED=
